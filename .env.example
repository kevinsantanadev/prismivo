# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Prismivo
APP_LOCALE=pt-BR
DEMO_MODE=true

# Independent authentication, PostgreSQL and private storage (Supabase)
# The publishable key is safe for browser use; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret used only by server-side rate limiting. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=prismivo-files
RATE_LIMIT_PEPPER=gere-um-segredo-longo-e-aleatorio-para-producao

# Transactional email
EMAIL_PROVIDER=development
EMAIL_FROM=Prismivo <no-reply@example.test>
RESEND_API_KEY=

# Private object storage
STORAGE_PROVIDER=development
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments (test mode only until production review)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability and privacy-aware analytics
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_KEY=

# Security
CRON_SECRET=
